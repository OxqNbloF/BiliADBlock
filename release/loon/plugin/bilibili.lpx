#!name=哔哩哔哩增强
#!desc=拜托，没有广告的哔哩哔哩真的超酷的
#!openUrl=https://apps.apple.com/app/id736536022
#!homepage=https://github.com/OxqNbloF/BiliADBlock/blob/dev/src/script/bilibili/README.md
#!tag=Enhancement
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!date=2026-09-02

[Argument]
showHotSearch=switch,false,tag=显示热搜
homeTabOrder=input,"live,recommend,popular,anime,film",tag=首页标签顺序,desc=填写 live、recommend、popular、anime、film 或中文标签名，以逗号分隔；缺少的标签按默认顺序追加

[Rewrite]
^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\? response-body-json-jq jq-path="https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/jq/bilibili.mine.jq"
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? mock-response-body data-type=text status-code=200 data="{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}"
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\? response-body-json-jq '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? response-body-json-jq 'if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end'
^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\? response-body-json-jq 'if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end'

[Script]
http-response ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(viewunite\.v1\.View\/(View|RelatesFeed|AIRelateAsync)|view\.v1\.View\/(View|RelatesFeed))$ script-path=https://raw.githubusercontent.com/OxqNbloF/BiliADBlock/refs/heads/dev/dist/bilibili.video-ads.js, requires-body=true, binary-body-mode=true, timeout=3, tag=bilibili.video-ads
http-response ^https:\/\/(app\.bilibili\.com\/x\/resource\/show\/tab\/v2|ap[ip]\.bilibili\.com\/x\/v2\/search\/square)(\?|$) script-path=https://raw.githubusercontent.com/OxqNbloF/BiliADBlock/refs/heads/dev/dist/bilibili.json.js, argument=[{showHotSearch}, {homeTabOrder}], requires-body=true, timeout=3, tag=bilibili.home

[MitM]
hostname = app.bilibili.com, api.bilibili.com, grpc.biliapi.net
